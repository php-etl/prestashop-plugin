{
    "name": "php-etl/prestashop-plugin",
    "description": "Plugin for Prestashop Extractor and Loader",
    "type": "gyroscops-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Grégory Planchat",
            "email": "gregory@kiboko.fr"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "php-etl/configurator-contracts": "0.8.*",
        "nikic/php-parser": "^5.6",
        "symfony/config": "^6.0",
        "php-etl/satellite-toolbox": "0.5.*",
        "php-etl/prestashop-api-client": "0.1.*"
    },
    "require-dev": {
        "php-etl/phpunit-extension": "*",
        "rector/rector": "^2.3",
        "php-etl/bucket-contracts": "0.3.*",
        "php-etl/bucket": "*",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Kiboko\\Plugin\\Prestashop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "functional\\Kiboko\\Plugin\\Prestashop\\": "tests/functional/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "gyroscops": {
            "plugins": ["Kiboko\\Plugin\\Prestashop\\Service"]
        }
    },
    "config": {
        "bin-dir": "bin",
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {"type": "path", "url": "../../phpunit-extension"},
        {"type": "vcs", "url": "https://github.com/php-etl/prestashop-webservice-lib"}
    ]
}
